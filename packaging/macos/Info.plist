<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>simpleKvm</string>
    <key>CFBundleDisplayName</key>
    <string>simpleKvm</string>
    <key>CFBundleIdentifier</key>
    <string>com.simplekvm.client</string>
    <key>CFBundleExecutable</key>
    <string>kvm-client</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleVersion</key>
    <string>0.1.0</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>LSUIElement</key>
    <true/>
    <!-- Required on macOS 15+: without this key the Local Network permission
         prompt never appears and LAN connections fail with "No route to host". -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Windows PC의 simpleKvm 서버에 연결해 키보드·마우스·클립보드를 공유하기 위해 로컬 네트워크 접근이 필요합니다.</string>
</dict>
</plist>
